generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  summaryEn String
  summaryEs String
  tags      String[]
  repoUrl   String?
  liveUrl   String?
  imageUrl  String?
  year      Int?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
