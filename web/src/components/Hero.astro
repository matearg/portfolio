---
import { copy, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const projects = lang === 'es' ? '/es/projects' : '/projects';
---
<canvas id="bg" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0"></canvas>
<section id="hero" aria-label="Intro" class="wrap" style="padding-block:clamp(40px,7vw,88px) 48px;min-height:780px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,500px),1fr));align-items:center;gap:24px 40px">
  <div style="display:flex;flex-direction:column;gap:28px">
    <p class="mono" style="margin:0;display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.04em;color:var(--muted)"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block"></span>{t.role} · Mar del Plata, Argentina</p>
    <h1 style="margin:0;font-size:clamp(48px,8.4vw,128px);line-height:.92;letter-spacing:-.045em;font-weight:600">Mateo<br />Arcidiacono<span style="color:var(--accent)">.</span></h1>
    <p style="margin:0;max-width:36ch;font-size:clamp(18px,1.6vw,21px);line-height:1.5;color:#b4b4bb">{t.tagline}</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn btn-a" href={projects}>{t.ctaProjects}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></a>
      <a class="btn btn-o" href="#contact">{t.ctaContact}</a>
    </div>
  </div>
  <div style="position:relative;width:100%;max-width:600px;aspect-ratio:1/1;justify-self:center">
    <canvas id="ico" role="img" aria-label="Wireframe geodesic sphere that morphs, follows the cursor and turns with scroll" style="display:block;width:100%;height:100%"></canvas>
    <span class="mono" aria-hidden="true" style="position:absolute;top:8px;left:8px;font-size:11px;color:#6b6b74">fig.01 — icosphere / 42v · 120e</span>
    <span class="mono" aria-hidden="true" style="position:absolute;bottom:8px;right:8px;font-size:11px;color:#6b6b74">{t.hint}</span>
  </div>
  <a href="#work" class="mono cue" style="grid-column:1/-1;justify-self:start;display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:12px;color:var(--muted);text-decoration:none">{t.scroll}<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4"></path></svg></a>
</section>

<script>
  const bg = document.getElementById('bg') as HTMLCanvasElement;
  const ico = document.getElementById('ico') as HTMLCanvasElement;
  const hero = document.getElementById('hero')!;
  const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
  const m = { x: -1e4, y: -1e4, tx: -1e4, ty: -1e4 };
  const tilt = { x: 0, y: 0 };

  // Icosahedron subdivided once: 42 vertices, 120 edges, on the unit sphere.
  function icosphere() {
    const t = (1 + Math.sqrt(5)) / 2;
    const v = [[-1,t,0],[1,t,0],[-1,-t,0],[1,-t,0],[0,-1,t],[0,1,t],[0,-1,-t],[0,1,-t],[t,0,-1],[t,0,1],[-t,0,-1],[-t,0,1]];
    const adj = (i: number, j: number) => Math.abs((v[i][0]-v[j][0])**2 + (v[i][1]-v[j][1])**2 + (v[i][2]-v[j][2])**2 - 4) < 1e-6;
    const key = (a: number, b: number) => (a < b ? a + '_' + b : b + '_' + a);
    const verts = v.map((p) => p.slice());
    const mids: Record<string, number> = {};
    const mid = (a: number, b: number) => {
      const k = key(a, b);
      if (mids[k] === undefined) {
        mids[k] = verts.length;
        verts.push([(v[a][0]+v[b][0])/2, (v[a][1]+v[b][1])/2, (v[a][2]+v[b][2])/2]);
      }
      return mids[k];
    };
    const edges = new Map<string, number[]>();
    const add = (a: number, b: number) => edges.set(key(a, b), [a, b]);
    for (let i = 0; i < 12; i++) for (let j = i + 1; j < 12; j++) for (let k = j + 1; k < 12; k++) {
      if (!(adj(i, j) && adj(j, k) && adj(i, k))) continue;
      const ab = mid(i, j), bc = mid(j, k), ca = mid(k, i);
      add(i, ab); add(ab, j); add(j, bc); add(bc, k); add(k, ca); add(ca, i); add(ab, bc); add(bc, ca); add(ca, ab);
    }
    return {
      verts: verts.map((p) => { const l = Math.hypot(p[0], p[1], p[2]); return [p[0]/l, p[1]/l, p[2]/l]; }),
      edges: [...edges.values()],
    };
  }
  const geo = icosphere();

  function fit(c: HTMLCanvasElement, maxDpr: number) {
    const w = c.clientWidth, h = c.clientHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
    const W = Math.round(w * dpr), H = Math.round(h * dpr);
    if (c.width !== W || c.height !== H) { c.width = W; c.height = H; }
    const ctx = c.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    return { ctx, w, h };
  }

  // Dot grid; dots near the cursor are pushed away, grow and take the accent.
  function drawField() {
    const { ctx, w, h } = fit(bg, 1);
    const gap = 28, R = 170;
    const near: number[][] = [];
    ctx.fillStyle = 'rgba(255,255,255,0.09)';
    for (let y = gap / 2; y < h; y += gap) for (let x = gap / 2; x < w; x += gap) {
      const dx = x - m.x, dy = y - m.y, d = Math.hypot(dx, dy);
      if (d < R) near.push([x, y, dx, dy, d]); else ctx.fillRect(x - 0.75, y - 0.75, 1.5, 1.5);
    }
    ctx.fillStyle = accent;
    near.forEach(([x, y, dx, dy, d]) => {
      const f = 1 - d / R, k = d ? (f * f * 22) / d : 0, s = 1.5 + f * 2;
      ctx.globalAlpha = 0.15 + f * 0.75;
      ctx.fillRect(x + dx * k - s / 2, y + dy * k - s / 2, s, s);
    });
    ctx.globalAlpha = 1;
  }

  function drawSphere(t: number) {
    const { ctx, w, h } = fit(ico, 2);
    const r = ico.getBoundingClientRect();
    const has = m.x > -5000;
    const tx = has ? (m.x - (r.left + r.width / 2)) / window.innerWidth : 0;
    const ty = has ? (m.y - (r.top + r.height / 2)) / window.innerHeight : 0;
    tilt.x += (tx - tilt.x) * 0.06;
    tilt.y += (ty - tilt.y) * 0.06;
    const p = Math.max(0, -hero.getBoundingClientRect().top) / 700;
    const ry = t * 0.22 + p * 2.6 + tilt.x * 1.6;
    const rx = 0.3 + p * 0.9 + tilt.y * 1.2;
    const cy = Math.cos(ry), sy = Math.sin(ry), cx = Math.cos(rx), sx = Math.sin(rx);
    const S = Math.min(w, h) * 0.28, ox = w / 2, oy = h / 2;
    const rot = (x: number, y: number, z: number) => { const x1 = x * cy + z * sy, z1 = -x * sy + z * cy; return [x1, y * cx - z1 * sx, y * sx + z1 * cx]; };
    const proj = (q: number[]) => { const k = 5 / (5 + q[2]); return [ox + q[0] * S * k, oy + q[1] * S * k, q[2]]; };
    const pts = geo.verts.map(([x, y, z]) => {
      const n = 1 + 0.11 * Math.sin(2.3 * x + t * 1.1) * Math.cos(2.1 * y + t * 0.8) + 0.05 * Math.sin(3.4 * z - t * 1.4);
      return proj(rot(x * n, y * n, z * n));
    });
    ctx.strokeStyle = accent;
    ctx.lineWidth = 1;
    geo.edges.forEach(([a, b]) => {
      const z = (pts[a][2] + pts[b][2]) / 2;
      ctx.globalAlpha = 0.12 + 0.78 * Math.min(1, Math.max(0, (1.15 - z) / 2.3));
      ctx.beginPath(); ctx.moveTo(pts[a][0], pts[a][1]); ctx.lineTo(pts[b][0], pts[b][1]); ctx.stroke();
    });
    ctx.fillStyle = '#ededee';
    pts.forEach(([x, y, z]) => { if (z < 0) { ctx.globalAlpha = Math.min(1, -z); ctx.fillRect(x - 1.5, y - 1.5, 3, 3); } });
    ctx.strokeStyle = '#ededee';
    ctx.globalAlpha = 0.22;
    ctx.setLineDash([2, 6]);
    ctx.beginPath();
    for (let i = 0; i <= 96; i++) {
      const a = (i / 96) * Math.PI * 2 + t * 0.15;
      const q = proj(rot(Math.cos(a) * 1.3, 0.2 * Math.sin(a), Math.sin(a) * 1.3));
      if (i) ctx.lineTo(q[0], q[1]); else ctx.moveTo(q[0], q[1]);
    }
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.globalAlpha = 1;
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  window.addEventListener('pointermove', (e) => { m.tx = e.clientX; m.ty = e.clientY; }, { passive: true });
  document.documentElement.addEventListener('pointerleave', () => { m.tx = m.ty = -1e4; });

  function loop(ms: number) {
    if (m.tx < -5000 || m.x < -5000) { m.x = m.tx; m.y = m.ty; }
    else { m.x += (m.tx - m.x) * 0.15; m.y += (m.ty - m.y) * 0.15; }
    drawField();
    drawSphere(ms / 1000);
    // Reduced motion: one still frame, no loop.
    if (!reduced) requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
</script>
