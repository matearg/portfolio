---
import { copy, type Lang } from '../i18n';
import CardMeta from './CardMeta.astro';
import type { Project } from '../lib/api';

interface Props { project: Project; lang: Lang; index: number; variant: 'home' | 'list' | 'featured'; }
const { project, lang, index, variant } = Astro.props;
const t = copy[lang];
const thumbs = ['t-grid', 't-rings', 't-lines', 't-dots', 't-bars', 't-diag'];
const thumb = thumbs[index % thumbs.length];
const n = String(index + 1).padStart(2, '0');
const summary = lang === 'es' ? project.summaryEs : project.summaryEn;
const year = project.year ?? '';
---
{variant === 'home' && (
  <a class="card card-link rv" href={lang === 'es' ? '/es/projects' : '/projects'} data-tags={project.tags.join('|')}>
    <div class={`thumb ${thumb}`} style="aspect-ratio:4/3;border:1px solid var(--border);border-radius:12px;display:flex;align-items:flex-end;padding:16px">
      {project.imageUrl && <img class="cover" src={project.imageUrl} alt="" loading="lazy" />}
      <span aria-hidden="true" style="position:absolute;top:16px;left:16px;width:8px;height:8px;background:var(--accent)"></span>
      <span class="mono" aria-hidden="true" style="position:relative;font-size:72px;line-height:1;color:#2a2a30">{n}</span>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:18px 2px 4px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
        <h3 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-.02em;transition:color .2s">{project.title}</h3>
        <span class="mono" style="font-size:12px;color:var(--muted)">{year}</span>
      </div>
      <p style="margin:0;font-size:15px;line-height:1.5;color:#a1a1aa">{summary}</p>
      <CardMeta project={project} lang={lang} links={false} />
    </div>
  </a>
)}

{variant === 'list' && (
  <article class="card card-box" data-tags={project.tags.join('|')}>
    <div class={`thumb ${thumb}`} style="aspect-ratio:16/10;display:flex;align-items:flex-end;padding:16px;border-bottom:1px solid #1d1d21">
      {project.imageUrl && <img class="cover" src={project.imageUrl} alt="" loading="lazy" />}
      <span class="mono" aria-hidden="true" style="position:relative;font-size:64px;line-height:1;color:#2a2a30">{n}</span>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding:20px 20px 8px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
        <h3 style="margin:0;font-size:21px;font-weight:600;letter-spacing:-.02em">{project.title}</h3>
        <span class="mono" style="font-size:12px;color:var(--muted)">{year}</span>
      </div>
      <p style="margin:0;font-size:15px;line-height:1.5;color:#a1a1aa">{summary}</p>
      <CardMeta project={project} lang={lang} />
    </div>
  </article>
)}

{variant === 'featured' && (
  <article class="card card-box" data-tags={project.tags.join('|')} style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));border-radius:16px">
    <div class={`thumb ${thumb}`} style="min-height:340px;display:flex;align-items:flex-end;padding:24px">
      {project.imageUrl && <img class="cover" src={project.imageUrl} alt="" />}
      <span aria-hidden="true" style="position:absolute;top:24px;left:24px;width:10px;height:10px;background:var(--accent)"></span>
      <span class="mono" aria-hidden="true" style="position:relative;font-size:120px;line-height:1;color:#26262c">{n}</span>
    </div>
    <div style="display:flex;flex-direction:column;gap:18px;padding:clamp(24px,4vw,48px);justify-content:center">
      <p class="mono" style="margin:0;font-size:12px;color:var(--accent)">★ {t.featured}{year && ` · ${year}`}</p>
      <h2 style="margin:0;font-size:clamp(30px,3.4vw,44px);line-height:1.05;letter-spacing:-.03em;font-weight:600">{project.title}</h2>
      <p style="margin:0;font-size:17px;line-height:1.55;color:#b4b4bb">{summary}</p>
      <CardMeta project={project} lang={lang} />
    </div>
  </article>
)}
