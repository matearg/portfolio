---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import { copy, stack, type Lang } from '../i18n';
import type { Contributions, Project } from '../lib/api';

interface Props { lang: Lang; projects: Project[]; activity: Contributions | null; }
const { lang, projects, activity } = Astro.props;
const t = copy[lang];
const loop = [...stack, ...stack, ...stack, ...stack]; // four copies so the -50% marquee never shows a gap at 1440px
const sec = 'padding-block:120px 40px;display:flex;flex-direction:column';
// Sections after Work shift by one when the activity section is shown.
const num = (i: number) => String(i + (activity ? 1 : 0)).padStart(2, '0');
const fmt = (n: number) => n.toLocaleString(lang);
// Calendar rows run Sunday..Saturday, so pad the first, partial week.
const pad = activity?.days.length ? new Date(activity.days[0].date).getUTCDay() : 0;
const stats = activity ? [
  [fmt(activity.total), t.activityTotal],
  [fmt(activity.commits), t.activityCommits],
  [fmt(activity.pullRequests), t.activityPrs],
  [`${activity.longestStreak}${t.activityDays}`, t.activityStreak],
] : [];
---
<Base lang={lang} page="home" activity={!!activity}>
  <main id="main" style="overflow-x:clip">
    <Hero lang={lang} />

    <section aria-label={t.stackLabel} style="border-block:1px solid #1d1d21;background:rgba(10,10,11,.6);overflow:hidden">
      <div class="marquee" style="display:flex;width:max-content">
        {loop.map((s, i) => (
          <span class="mono" aria-hidden={i >= stack.length ? 'true' : undefined} style="display:inline-flex;align-items:center;gap:28px;padding:22px 0 22px 28px;font-size:15px;color:#d4d4d8;white-space:nowrap">{s}<span aria-hidden="true" style="width:6px;height:6px;background:var(--accent);transform:rotate(45deg);display:inline-block"></span></span>
        ))}
      </div>
    </section>

    <section id="work" class="wrap" style={`${sec};gap:48px`}>
      <SectionHead num="01" label={t.workLabel} title={t.workTitle}>
        <a class="ul" href={lang === 'es' ? '/es/projects' : '/projects'}>{t.workAll} →</a>
      </SectionHead>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px">
        {projects.slice(0, 3).map((p, i) => <ProjectCard project={p} lang={lang} index={i} variant="home" />)}
      </div>
    </section>

    {activity && (
      <section id="activity" class="wrap" style={`${sec};gap:40px`}>
        <SectionHead num="02" label={t.activityLabel} title={t.activityTitle}>
          <a class="ul" href="https://github.com/matearg" rel="noopener">{t.activityProfile} ↗</a>
        </SectionHead>
        <div class="rv" style="display:flex;flex-direction:column;gap:16px;padding:clamp(16px,3vw,28px);border:1px solid var(--border);border-radius:14px;background:rgba(17,17,19,.78)">
          <div class="cal-scroll">
            <div class="cal" role="img" aria-label={`${fmt(activity.total)} ${t.activityTotal}`}>
              {Array.from({ length: pad }, () => <span style="visibility:hidden"></span>)}
              {activity.days.map((d) => <span class={`cell l${d.level}`} title={`${d.count} · ${d.date}`}></span>)}
            </div>
          </div>
          <div class="mono" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;font-size:12px;color:var(--muted)">
            <span>{fmt(activity.total)} {t.activityTotal}</span>
            <span aria-hidden="true" style="display:inline-flex;align-items:center;gap:4px">{t.activityLess} {[0, 1, 2, 3, 4].map((l) => <span class={`cell l${l}`} style="width:12px"></span>)} {t.activityMore}</span>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:24px">
          {stats.map(([v, k], i) => (
            <div class={`rv ${['', 'rv2', 'rv3', 'rv3'][i]}`} style="display:flex;flex-direction:column;gap:8px;padding-top:16px;border-top:1px solid #2a2a2f">
              <span style="font-size:clamp(32px,4vw,48px);font-weight:600;letter-spacing:-.03em;line-height:1">{v}</span>
              <span class="mono" style="font-size:12px;color:var(--muted)">{k}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <section id="about" class="wrap" style={`${sec};gap:56px`}>
      <SectionHead num={num(2)} label={t.aboutLabel} title={t.aboutTitle} maxWidth="16ch" />
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 64px;align-items:start">
        <p class="rv" style="margin:0;font-size:clamp(19px,1.8vw,24px);line-height:1.55;color:#c4c4cc">{t.aboutBody}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:24px">
          {t.cols.map((c) => (
            <div class={`rv ${c.rvc}`} style="display:flex;flex-direction:column;gap:12px;padding-top:16px;border-top:1px solid #2a2a2f">
              <p class="mono" style="margin:0;font-size:12px;color:var(--accent)">{c.label}</p>
              <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15px;line-height:1.4;color:#c4c4cc">
                {c.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <h3 class="rv" style="margin:0 0 8px;font-size:22px;font-weight:600">{t.expTitle}</h3>
        <ol style="margin:0;padding:0;list-style:none">
          {t.exp.map((e) => (
            <li class="rv" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:8px 32px;padding:24px 0;border-top:1px solid #1d1d21">
              <span class="mono" style="font-size:13px;color:var(--muted)">{e.period}</span>
              <span style="font-size:18px;font-weight:500">{e.role} <span style="color:#8f8f98">· {e.company}</span></span>
              <span style="font-size:15px;line-height:1.5;color:#a1a1aa">{e.desc}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contact" class="wrap" style="padding-block:120px 80px">
      <div class="rv" style="display:flex;flex-direction:column;gap:28px;padding:clamp(28px,5vw,72px);border:1px solid var(--border);border-radius:20px;background:rgba(17,17,19,.78)">
        <p class="mono" style="margin:0;font-size:13px;color:var(--accent)">{num(3)} / {t.contactLabel}</p>
        <h2 style="margin:0;font-size:clamp(44px,7vw,112px);line-height:.95;letter-spacing:-.045em;font-weight:600">{t.contactTitle}</h2>
        <p style="margin:0;max-width:40ch;font-size:19px;line-height:1.5;color:#b4b4bb">{t.contactBody}</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <a class="btn btn-a" href="mailto:mateoarcidiacono@gmail.com">mateoarcidiacono@gmail.com</a>
          <a class="btn btn-o" href="https://github.com/matearg" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>
</Base>
